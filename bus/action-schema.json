{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevCrew Action Envelope",
  "description": "Стандартное сообщение шины между агентами (общий регистр действий)",
  "type": "object",
  "required": ["id", "actor", "action", "target", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Уникальный id сообщения (UUID)"
    },
    "actor": {
      "type": "string",
      "enum": ["developer", "qa", "tech-pm", "orchestrator"],
      "description": "Кто отправил действие"
    },
    "action": {
      "type": "string",
      "description": "Тип действия, например: task.created, pr.opened, review.requested, test.failed, memory.write"
    },
    "target": {
      "type": "string",
      "description": "Получатель: id агента или '*' (broadcast)"
    },
    "payload": {
      "type": "object",
      "description": "Полезная нагрузка действия (произвольный JSON)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Время отправки (ISO 8601)"
    }
  }
}
