{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DevCrew Action Envelope",
  "description": "Standard message on the bus between agents (shared action registry)",
  "type": "object",
  "required": ["id", "actor", "action", "target", "timestamp"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique message id (UUID)"
    },
    "actor": {
      "type": "string",
      "enum": ["developer", "qa", "tech-pm", "devops", "orchestrator"],
      "description": "Who sent the action"
    },
    "action": {
      "type": "string",
      "description": "Action type, e.g. task.created, task.started, task.finished, task.stale, pr.opened, review.requested, bug.found, skill.created, skill.patched, test.failed, memory.write"
    },
    "target": {
      "type": "string",
      "description": "Recipient: agent id or '*' (broadcast)"
    },
    "payload": {
      "type": "object",
      "description": "Action payload (arbitrary JSON)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Send time (ISO 8601)"
    }
  }
}
