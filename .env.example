# ============================================================
# Dev Crew — environment template (real values go in .env, which
# is NOT committed). Copy: cp .env.example .env
# ============================================================

# --- Shared action registry (bus) ---
# Redis: address of the shared-memory container
BUS_REDIS_URL=redis://shared-memory:6379

# --- GitHub ---
# Token can be shared across agents or individual.
# Individual ones — in tokens/tokens.yaml (see tokens.example.yaml)
GITHUB_TOKEN=

# --- Linear (source of truth for tickets/Projects) ---
# Used by the completion watcher + run-supervision view for auto-comments and
# state moves. Read-only scoped key preferred.
LINEAR_API_KEY=

# --- Task completion (deterministic hooks, dashboard/completion_watcher.py) ---
# Manager webhook to ping on task finish (best-effort; empty = skip ping).
# This is a Hermes `--deliver-only` webhook subscription on the manager gateway,
# e.g. http://localhost:8644/webhooks/dev-crew-manager-ping.
MANAGER_WEBHOOK_URL=
# HMAC secret for the manager webhook (X-Hub-Signature-256).
MANAGER_WEBHOOK_SECRET=
# Silence threshold before a `task.stale` bus event fires (minutes).
WATCHER_STALE_MINUTES=30

# --- LLM (OpenAI-compatible contract) ---
# Default fallback provider, unless an agent sets its own in tokens.yaml
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Orchestration ---
COMPOSE_PROJECT_NAME=dev-crew

# --- Generic environments ---
# dev-env (dev-crew-dev-env) and staging-env (dev-crew-staging-env) are empty
# networks the foundation provides. Projects bring their own compose
# (workspace/<project>/compose.yml) and attach via `external: true`.
# No per-project connection secrets live here — they live in the project.
