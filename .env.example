# ============================================================
# Dev Crew — шаблон окружения (реальные значения в .env, который
# в git НЕ попадает). Скопируй: cp .env.example .env
# ============================================================

# --- Общий регистр действий (шина) ---
# Redis: адрес shared-memory контейнера
BUS_REDIS_URL=redis://shared-memory:6379

# --- GitHub ---
# Токен может быть общим для всех агентов или индивидуальным.
# Индивидуальные — в tokens/tokens.yaml (см. tokens.example.yaml)
GITHUB_TOKEN=

# --- LLM (OpenAI-совместимый контракт) ---
# Общий fallback-провайдер, если агент не задал свой в tokens.yaml
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Оркестрация ---
COMPOSE_PROJECT_NAME=dev-crew
