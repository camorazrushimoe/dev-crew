# ============================================================
# Dev Crew — environment template (real values go in .env, which
# is NOT committed). Copy: cp .env.example .env
# ============================================================

# --- LLM (runinfra, one key shared by all agents) ---
CUSTOM_API_KEY=

# --- Office attach (Office-attached mode = DEFAULT compose) ---
# Instance id: qualifies container names and bus actor ids.
TEAM_NAME=dev-crew
# Office shared Redis bus (service name 'shared-memory' on agent-office-crew).
OFFICE_BUS_URL=redis://shared-memory:6379
# Per-agent door HMAC secrets (must match crew/agents.json + config.yaml.template).
DOOR_SECRET_DEVELOPER=
DOOR_SECRET_QA=
DOOR_SECRET_TECH_PM=
DOOR_SECRET_DEVOPS=
# Optional host port overrides (defaults: 8651–8654).
# DEV_PORT_DEVELOPER=8661
# DEV_PORT_QA=8662
# DEV_PORT_TECH_PM=8663
# DEV_PORT_DEVOPS=8664

# --- Standalone mode (docker-compose.standalone.yml) ---
BUS_REDIS_URL=redis://shared-memory:6379
COMPOSE_PROJECT_NAME=dev-crew

# --- GitHub ---
# Token can be shared across agents or individual.
# Individual ones — in tokens/tokens.yaml (see tokens.example.yaml)
GITHUB_TOKEN=

# --- Linear (source of truth for tickets/Projects) ---
LINEAR_API_KEY=

# --- Task completion (deterministic hooks, dashboard/completion_watcher.py) ---
MANAGER_WEBHOOK_URL=
MANAGER_WEBHOOK_SECRET=
WATCHER_STALE_MINUTES=30

# --- Hermes process user inside containers ---
HERMES_UID=501
HERMES_GID=20
